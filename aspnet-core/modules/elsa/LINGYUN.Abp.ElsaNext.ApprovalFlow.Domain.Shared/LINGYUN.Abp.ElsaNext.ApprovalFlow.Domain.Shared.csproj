<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\..\..\..\configureawait.props" />
	<Import Project="..\..\..\..\common.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>LINGYUN.Abp.ElsaNext.ApprovalFlow.Domain.Shared</AssemblyName>
		<PackageId>LINGYUN.Abp.ElsaNext.ApprovalFlow.Domain.Shared</PackageId>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace />
		<!-- The approval flow sources were reconstructed from compiled artifacts, which do not preserve nullable flow analysis. Keep the annotations but do not report nullable analysis warnings. -->
		<Nullable>annotations</Nullable>

	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="LINGYUN\Abp\ElsaNext\ApprovalFlow\Localization\Domain\*.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Volo.Abp.Validation" />
	</ItemGroup>

</Project>
