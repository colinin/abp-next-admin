<Project Sdk="Microsoft.NET.Sdk.Razor">

	<Import Project="..\..\..\..\configureawait.props" />
	<Import Project="..\..\..\..\common.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>LINGYUN.Abp.ElsaNext.Studio.Blazor</AssemblyName>
		<PackageId>LINGYUN.Abp.ElsaNext.Studio.Blazor</PackageId>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<Content Remove="Localization\Resources\ElsaStudioBlazor\*.json" />
		<EmbeddedResource Include="Localization\Resources\ElsaStudioBlazor\*.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Volo.Abp.Localization" />
		<PackageReference Include="Volo.Abp.UI.Navigation" />
		<PackageReference Include="Volo.Abp.VirtualFileSystem" />
		<PackageReference Include="Volo.Abp.AspNetCore.Components.Web.Theming.MudBlazor" />
		<PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.Bundling.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Elsa.Studio.Core.BlazorServer" />
		<PackageReference Include="Elsa.Studio.Settings" />
		<PackageReference Include="Elsa.Studio.Shell" />
		<PackageReference Include="Elsa.Studio.WorkflowContexts" />
		<PackageReference Include="Elsa.Studio.Workflows" />
		<PackageReference Include="Elsa.Studio.Workflows.Designer" />
		<PackageReference Include="Elsa.Api.Client" />
		<PackageReference Include="Elsa.Studio.Authentication.Abstractions" />
		<PackageReference Include="Elsa.Studio.Localization.BlazorServer" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LINGYUN.Abp.ElsaNext\LINGYUN.Abp.ElsaNext.csproj" />
	</ItemGroup>

</Project>
