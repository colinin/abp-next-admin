<Project Sdk="Microsoft.NET.Sdk.Web">

	<Import Project="..\..\..\..\configureawait.props" />
	<Import Project="..\..\..\..\common.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>LINGYUN.Abp.Account.Web.LazyCaptcha</AssemblyName>
		<PackageId>LINGYUN.Abp.Account.Web.LazyCaptcha</PackageId>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<RootNamespace>LINGYUN.Abp.Account.Web.LazyCaptcha</RootNamespace>
		<OutputType>Library</OutputType>
		<IsPackable>true</IsPackable>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<Content Remove="Pages\**\*.css" />
		<Content Remove="Pages\**\*.js" />
		<Content Remove="wwwroot\**\*.css" />
		<Content Remove="wwwroot\**\*.js" />
		<EmbeddedResource Include="wwwroot\**\*.css" />
		<EmbeddedResource Include="wwwroot\**\*.js" />
		<EmbeddedResource Include="Pages\**\*.css" />
		<EmbeddedResource Include="Pages\**\*.js" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\captcha\LINGYUN.Abp.LazyCaptcha\LINGYUN.Abp.LazyCaptcha.csproj" />
		<ProjectReference Include="..\LINGYUN.Abp.Account.Web\LINGYUN.Abp.Account.Web.csproj" />
	</ItemGroup>

</Project>
