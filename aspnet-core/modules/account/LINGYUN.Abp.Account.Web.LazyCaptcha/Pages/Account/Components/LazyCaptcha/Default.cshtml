@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization

@inject IHtmlLocalizer<AccountResource> L

@model LINGYUN.Abp.Account.Web.LazyCaptcha.Pages.Account.Components.LazyCaptcha.LazyCaptchaViewComponentModel

<div class="mb-3">
    <label asp-for="PasswordLoginInput.CaptchaCode" class="form-label"></label>
    <div class="input-group">
        <input asp-for="PasswordLoginInput.CaptchaCode" class="form-control" autocomplete="off" id="CaptchaCode" required />
        <img class="captcha-img" id="CaptchaImg" />
    </div>
    <span asp-validation-for="PasswordLoginInput.CaptchaCode" class="text-danger"></span>
</div>