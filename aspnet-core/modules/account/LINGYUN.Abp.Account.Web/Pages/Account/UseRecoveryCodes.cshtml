@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@model LINGYUN.Abp.Account.Web.Pages.Account.UseRecoveryCodesModel
@inject IHtmlLocalizer<AccountResource> L

<div class="card mt-3 shadow-sm rounded">
    <div class="card-body p-5">
        <h4>@L["UseRecoveryCodes"]</h4>
        <p class="mb-3">@L["UseRecoveryCodesDesc"]</p>

        <form method="post" class="mt-4">
            <div class="mb-3">
                <label asp-for="Input.RecoveryCode" class="form-label"></label>
                <input asp-for="Input.RecoveryCode"
                       class="form-control"
                       autocomplete="off"
                       autofocus
                       placeholder="@L["RecoveryCodePlaceholder"]" />
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input type="checkbox" asp-for="Input.RememberBrowser" class="form-check-input" />
                <label asp-for="Input.RememberBrowser" class="form-label"></label>
            </div>

            <div class="d-grid gap-2">
                <abp-button type="submit" button-type="Primary" class="btn-block btn-lg">
                    @L["VerifyRecoveryCode"]
                </abp-button>
                <a abp-button="Secondary"
                   asp-page="./VerifyAuthenticatorCode"
                   class="btn-block btn-lg"
                   asp-all-route-data="@(new Dictionary<string, string?> {
                      { "returnUrl", Model.ReturnUrl },
                      { "returnUrlHash", Model.ReturnUrlHash },
                      { "rememberMe", Model.RememberMe.ToString() },
                      { "linkUserId", Model.LinkUserId?.ToString() },
                      { "linkTenantId", Model.LinkTenantId?.ToString() },
                      { "linkToken", Model.LinkToken }
                  })">
                    <i class="fa fa-long-arrow-left"></i>
                    @L["BackToVerifyCode"]
                </a>
            </div>
        </form>
    </div>
</div>