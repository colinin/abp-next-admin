@page
@inject IHtmlLocalizer<AccountResource> L
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@model LINGYUN.Abp.Account.Web.Pages.Account.UserEmailConfirmModel
@inject Volo.Abp.AspNetCore.Mvc.UI.Layout.IPageLayout PageLayout
<div class="card mt-3 shadow-sm rounded">
    <div class="card-body p-5">
        <h4>@L["EmailConfirm"]</h4>
        <form method="post">
            <input asp-for="Input.UserId" />
            <div class="mb-3">
                <label asp-for="Input.EmailAddress" class="form-label"></label>
                <input asp-for="Input.EmailAddress" class="form-control" readonly />
                <span asp-validation-for="Input.EmailAddress" class="text-danger"></span>
            </div>

                <div class="d-grid gap-2">
                @if (!Model.AlreadySend)
                {
                    <abp-button type="submit" button-type="Primary" class="btn-block btn-lg">@L["SendVerifyCode"]</abp-button>
                }
                <a abp-button="Secondary"
                   asp-page="./Login"
                   asp-all-route-data="@(new Dictionary<string, string?> {
                       { "returnUrl", Model.ReturnUrl },
                       { "returnUrlHash", Model.ReturnUrlHash } ,
                       { "linkUserId", Model.LinkUserId?.ToString() },
                       { "linkTenantId", Model.LinkTenantId?.ToString() },
                       { "linkToken", Model.LinkToken }
                   })">
                    <i class="fa fa-long-arrow-left"></i>
                    @L["BackToLogin"]
                </a>
            </div>
        </form>
    </div>
</div>
