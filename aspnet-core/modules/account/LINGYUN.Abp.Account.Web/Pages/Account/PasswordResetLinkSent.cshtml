@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Volo.Abp.AspNetCore.Mvc.UI.Theming;
@model LINGYUN.Abp.Account.Web.Pages.Account.PasswordResetLinkSentModel
@inject IHtmlLocalizer<AccountResource> L
@inject IThemeManager ThemeManager
@inject IPageLayout PageLayout

@{
    PageLayout.Content.Title = L["ForgotPassword"].Value;
}

<div class="card mt-3 shadow-sm rounded">
    <div class="card-body p-5">
        <form method="post" class="mt-4">
            <p>@L["PasswordResetMailSentMessage"]</p>
            <a abp-button="Secondary"
               asp-page="./Login"
               class="btn-block btn-lg"
               asp-all-route-data="@(new Dictionary<string, string?> {
                      { "returnUrl", Model.ReturnUrl },
                      { "returnUrlHash", Model.ReturnUrlHash } ,
                      { "linkUserId", Model.LinkUserId?.ToString() },
                      { "linkTenantId", Model.LinkTenantId?.ToString() },
                      { "linkToken", Model.LinkToken }
                  })">
                <i class="fa fa-long-arrow-left"></i>
                @L["BackToLogin"]
            </a>
        </form>
    </div>
</div>
