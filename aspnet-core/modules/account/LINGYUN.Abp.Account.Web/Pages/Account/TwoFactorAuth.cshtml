@page
@using LINGYUN.Abp.Account.Web.Pages.Account
@using Microsoft.AspNetCore.Mvc.Localization;
@using Volo.Abp.Account.Localization;
@using Volo.Abp.AspNetCore.Mvc.UI.Theming;
@model LINGYUN.Abp.Account.Web.Pages.Account.TwoFactorAuthModel
@inject IThemeManager ThemeManager
@inject Volo.Abp.AspNetCore.Mvc.UI.Layout.IPageLayout PageLayout
@inject IHtmlLocalizer<AccountResource> L

@{
    Layout = ThemeManager.CurrentTheme.GetAccountLayout();
    PageLayout.Content.Title = L["TwoFactorAuth"].Value;
}

@section scripts
{
    <abp-script-bundle name="@typeof(TwoFactorAuthModel).FullName" />
}

<div class="card mt-3 shadow-sm rounded">
    <div class="card-body p-5">
        <h4>@L["Authenticator"]</h4>
        <p class="mb-3">@L["AuthenticatorDesc"]</p>
        <form method="post" class="mt-4">
            <input asp-for="AuthenticatorUri" id="AuthenticatorUri" />
            @if (!string.IsNullOrWhiteSpace(@Model.AuthenticatorUri))
            {
                <div class="d-flex flex-row justify-content-center align-items-center gap-2 mt-2">
                    <div class="w-50">
                        <div class="d-flex flex-column justify-content-center">
                            <h5>@L["Authenticator:UseQrCode"]</h5>
                            <div id="QrCode"></div>
                        </div>
                    </div>
                    <div class="w-50">
                        <div class="d-flex flex-column justify-content-center">
                            <h5>@L["Authenticator:InputCode"]</h5>
                            <button type="button" id="copySharedKey" class="btn btn-outline-primary btn-sm mt-1">@L["Authenticator:CopyToClipboard"]</button>
                            <div id="sharedKey" class="bg-light rounded">
                                <code class="fs-4 lh-lg">@Model.SharedKey</code>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Code" class="form-label"></label>
                <input asp-for="Input.Code" class="form-control" />
                <span asp-validation-for="Input.Code" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input type="checkbox" asp-for="Input.RememberBrowser" class="form-check-input" />
                <label asp-for="Input.RememberBrowser" class="form-label"></label>
            </div>

            <div class="d-grid gap-2">
                <abp-button type="submit" button-type="Primary" class="btn-block btn-lg">@L["UseAuthenticator"]</abp-button>
                <a abp-button="Secondary"
                    asp-page="./Login"
                    asp-all-route-data="@(new Dictionary<string, string?> { 
                        { "returnUrl", Model.ReturnUrl }, 
                        { "returnUrlHash", Model.ReturnUrlHash } ,
                        { "rememberMe", Model.RememberMe.ToString() },
                        { "linkUserId", Model.LinkUserId?.ToString() },
                        { "linkTenantId", Model.LinkTenantId?.ToString() },
                        { "linkToken", Model.LinkToken }
                    })"><i class="fa fa-long-arrow-left"></i>
                    @L["BackToLogin"]</a>
            </div>
        </form>
    </div>
</div>
