{
  "AgileConfig": {
    "IsEnabled": false,
    "env": "Prod",
    "appId": "PackageName.CompanyName.ProjectName",
    "secret": "1q2w3E*",
    "nodes": "http://127.0.0.1:15000",
    "name": "PackageName.CompanyName.ProjectName",
    "tag": "PackageName.CompanyName.ProjectName"
  },
  "Logging": {
    "Serilog": {
      "Elasticsearch": {
        "IndexFormat": "abp.prod.logging-{0:yyyy.MM.dd}"
      }
    }
  },
  "AuditLogging": {
    "Elasticsearch": {
      "IndexPrefix": "abp.prod.auditing"
    }
  },
  "Elasticsearch": {
    "NodeUris": "http://127.0.0.1:9200"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "DotNetCore": "Warning",
        "PackageName.CompanyName.ProjectName": "Information"
      }
    },
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Elasticsearch", "Serilog.Sinks.OpenTelemetry" ],
    "WriteTo": [
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://localhost:9200",
          "indexFormat": "abp.prod.logging-{0:yyyy.MM.dd}",
          "autoRegisterTemplate": true,
          "autoRegisterTemplateVersion": "ESv7"
        }
      },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4318",
          "protocol": "HttpProtobuf",
          "resourceAttributes": {
            "service.name": "ProjectNameService",
            "deployment.environment": "production"
          }
        }
      }
    ]
  }
}
