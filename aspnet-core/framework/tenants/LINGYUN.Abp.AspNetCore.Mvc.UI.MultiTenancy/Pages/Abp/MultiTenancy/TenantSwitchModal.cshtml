@page
@using LINGYUN.Abp.MicroService.AuthServer.Pages.Abp.MultiTenancy
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@using Volo.Abp.AspNetCore.Mvc.UI.MultiTenancy.Localization
@model TenantSwitchModalModel
@inject IHtmlLocalizer<AbpUiMultiTenancyResource> L
@{
    Layout = null;
}

@if (Model.AvailableTenants.Count > 0)
{
    <abp-dynamic-form abp-model="@Model.TenantSelect" asp-page="/Abp/MultiTenancy/TenantSwitchModal" asp-page-handler="TenantSwitch">
        <abp-modal>
            <abp-modal-header title="@L["SwitchTenant"].Value"></abp-modal-header>
            <abp-modal-body>
                <abp-form-content />
            </abp-modal-body>
            <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
        </abp-modal>
    </abp-dynamic-form>
}

@if (Model.AvailableTenants.Count == 0)
{
    <abp-dynamic-form abp-model="@Model.TenantInput" asp-page="/Abp/MultiTenancy/TenantSwitchModal" asp-page-handler="TenantInput">
        <abp-modal>
            <abp-modal-header title="@L["SwitchTenant"].Value"></abp-modal-header>
            <abp-modal-body>
                <abp-form-content />
            </abp-modal-body>
            <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
        </abp-modal>
    </abp-dynamic-form>
}
